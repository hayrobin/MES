# PHASE_1_CONFIG_ONLY
# MES Configuration Layer Environment Variables

# Database Configuration
DATABASE_URL=sqlite:///./mes_config.db
# For PostgreSQL: postgresql://user:password@localhost:5432/mes_config

# API Configuration
API_V1_PREFIX=/api/v1/mes-config
HOST=0.0.0.0
PORT=8000

# Application
APP_NAME=MES Configuration Layer
DEBUG=True

# Security (for future use)
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
