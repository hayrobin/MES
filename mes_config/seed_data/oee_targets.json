      "id": 8,
      "code": "KPI-MTBF",
      "name": "Mean Time Between Failures",
      "description": "Average time between equipment failures",
      "category": "MAINTENANCE",
      "calculation_formula": "Total Operating Time / Number of Failures",
      "uom_id": 5,
      "target_value": 168.0,
      "target_threshold_upper": null,
      "target_threshold_lower": 120.0,
      "aggregation_method": "AVERAGE",
