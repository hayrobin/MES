  "kpi_definitions": [
    {
      "id": 1,
      "code": "KPI-YIELD",
      "name": "Yield Percentage",
      "description": "Ratio of good parts produced to total parts started",
      "category": "QUALITY",
      "calculation_formula": "(Good Parts / Total Parts Started) * 100",
      "uom_id": null,
      "target_value": 98.0,
      "target_threshold_upper": 100.0,
      "target_threshold_lower": 95.0,
      "aggregation_method": "AVERAGE",
      "is_active": true,
      "approval_status": "APPROVED",
      "created_by": "system_admin",
      "created_at": "2024-01-01T08:00:00Z",
      "updated_by": "system_admin",
      "updated_at": "2024-01-01T08:00:00Z"
    },
    {
      "id": 2,
      "code": "KPI-SCRAP",
      "name": "Scrap Rate Percentage",
      "description": "Percentage of parts scrapped during production",
      "category": "QUALITY",
      "calculation_formula": "(Scrapped Parts / Total Parts Started) * 100",
      "uom_id": null,
      "target_value": 1.5,
      "target_threshold_upper": 3.0,
      "target_threshold_lower": 0.0,
      "aggregation_method": "AVERAGE",
      "is_active": true,
      "approval_status": "APPROVED",
      "created_by": "system_admin",
      "created_at": "2024-01-01T08:00:00Z",
      "updated_by": "system_admin",
      "updated_at": "2024-01-01T08:00:00Z"
    },
    {
      "id": 3,
      "code": "KPI-REWORK",
      "name": "Rework Rate Percentage",
      "description": "Percentage of parts requiring rework",
      "category": "QUALITY",
      "calculation_formula": "(Reworked Parts / Total Parts Produced) * 100",
      "uom_id": null,
      "target_value": 0.5,
      "target_threshold_upper": 2.0,
      "target_threshold_lower": 0.0,
      "aggregation_method": "AVERAGE",
      "is_active": true,
      "approval_status": "APPROVED",
      "created_by": "system_admin",
      "created_at": "2024-01-01T08:00:00Z",
      "updated_by": "system_admin",
      "updated_at": "2024-01-01T08:00:00Z"
    },
    {
      "id": 4,
      "code": "KPI-OEE",
      "name": "Overall Equipment Effectiveness",
      "description": "Product of Availability, Performance, and Quality percentages",
      "category": "PRODUCTIVITY",
      "calculation_formula": "(Availability % * Performance % * Quality %) / 10000",
      "uom_id": null,
      "target_value": 80.0,
      "target_threshold_upper": 100.0,
      "target_threshold_lower": 70.0,
      "aggregation_method": "AVERAGE",
      "is_active": true,
      "approval_status": "APPROVED",
      "created_by": "system_admin",
      "created_at": "2024-01-01T08:00:00Z",
      "updated_by": "system_admin",
      "updated_at": "2024-01-01T08:00:00Z"
    },
    {
      "id": 5,
      "code": "KPI-THROUGHPUT",
      "name": "Throughput",
      "description": "Total units produced per unit time",
      "category": "PRODUCTIVITY",
      "calculation_formula": "Total Good Parts Produced / Operating Time",
      "uom_id": 1,
      "target_value": null,
      "target_threshold_upper": null,
      "target_threshold_lower": null,
      "aggregation_method": "SUM",
      "is_active": true,
      "approval_status": "APPROVED",
      "created_by": "system_admin",
      "created_at": "2024-01-01T08:00:00Z",
      "updated_by": "system_admin",
      "updated_at": "2024-01-01T08:00:00Z"
    },
    {
      "id": 6,
      "code": "KPI-CAPACITY-UTIL",
      "name": "Capacity Utilization",
      "description": "Actual production vs maximum theoretical capacity",
      "category": "PRODUCTIVITY",
      "calculation_formula": "(Actual Production / Rated Capacity) * 100",
      "uom_id": null,
      "target_value": 85.0,
      "target_threshold_upper": 95.0,
      "target_threshold_lower": 75.0,
      "aggregation_method": "AVERAGE",
      "is_active": true,
      "approval_status": "APPROVED",
      "created_by": "system_admin",
      "created_at": "2024-01-01T08:00:00Z",
      "updated_by": "system_admin",
      "updated_at": "2024-01-01T08:00:00Z"
    },
    {
      "id": 7,
      "code": "KPI-DOWNTIME",
      "name": "Downtime",
      "description": "Total unplanned downtime during production",
      "category": "MAINTENANCE",
      "calculation_formula": "Sum of all unplanned downtime events",
      "uom_id": 6,
      "target_value": 30.0,
